{
	"name": "ksys-studio-template",
	"private": true,
	"version": "0.1.0",
	"description": "Generic Kurtosys Studio monorepo template — Fund Centre + product-page embeds, reusable across clients",
	"type": "module",
	"scripts": {
		"apps:list": "node scripts/list-apps.mjs",
		"apps:add": "node scripts/add-app.mjs",
		"apps:rename": "node scripts/rename-app.mjs",
		"client:set": "node scripts/set-client.mjs",
		"dev": "node scripts/run-app.mjs dev",
		"build:dev": "node scripts/build-all.mjs dev",
		"test": "node scripts/run-all.mjs test",
		"test:embed-css": "node --test scripts/embed-css.test.mjs",
		"test:content": "node --test scripts/content-copies.test.mjs",
		"lint": "node scripts/run-all.mjs lint",
		"audit:security": "python3 tools/security_audit_report.py",
		"audit:deps": "node scripts/run-all.mjs audit:deps",
		"docs:user-guide": "python3 tools/build_user_guide_pdf.py",
		"init": "node scripts/init-project.mjs",
		"host:set": "node scripts/init-project.mjs --force",
		"build:stg": "node scripts/build-all.mjs stg",
		"build:prd": "node scripts/build-all.mjs prd",
		"build:stg:dxm": "node scripts/build-all.mjs stg --host dxm",
		"build:stg:cms": "node scripts/build-all.mjs stg --host cms",
		"build:prd:dxm": "node scripts/build-all.mjs prd --host dxm",
		"build:prd:cms": "node scripts/build-all.mjs prd --host cms"
	}
}
